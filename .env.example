# ScamTrap Bharat Environment Configuration
# Copy this file to .env and fill in the values you need.
# ALL keys are OPTIONAL — the app runs fully offline without them.

PORT=8050
HOST=0.0.0.0
ENVIRONMENT=development
SANDBOX_MODE=true
DB_PATH=storage/scamtrap.db

# ---- AI Provider Chain (Tab 2 Honeypot + Tab 1 OCR/QR/Audio) --------------
# Priority: Ollama (local, free) -> Groq (cloud, free tier) -> Gemini (cloud)
# Leave all blank to run 100% offline on Ollama only.

# Ollama — local, free, no key needed. Models auto-detected from `ollama list`.
# Install: https://ollama.com  |  Pull models: ollama pull deepseek-r1:8b
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=deepseek-r1:8b

# Groq — free tier cloud fallback (optional)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini — last-resort fallback + vision/OCR/audio (optional)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
